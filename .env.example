# .env.example — HALIMA Execution API

# ─── Required ───
# OpenRouter API key (get free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── Server ───
API_HOST=0.0.0.0
API_PORT=8080

# ─── Auth ───
# Internal key for service-to-service calls (A2A)
INTERNAL_KEY=hermes-mcp-internal-v1

# Admin password for admin endpoints
ADMIN_PASSWORD=change-me-in-production

# ─── Payments (optional) ───
# USDC wallet for x402 micropayments
WALLET_ADDRESS=0xYourWalletAddress
WALLET_PRIVATE_KEY=0xYourPrivateKey

# Base chain config
BASE_CHAIN_ID=8453
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ─── Pricing ───
PRICE_USDC=0.01

# ─── Rate Limiting ───
RATE_LIMIT_RPM=30
DAILY_SPEND_LIMIT=5.0
FREE_TIER_DAILY=10

# ─── Observability ───
LOG_DIR=/root/.hermes/logs
LOG_LEVEL=INFO
